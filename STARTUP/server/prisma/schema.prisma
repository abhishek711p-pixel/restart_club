generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email            String   @id
  username         String
  password         String
  batch            String
  purchasedBatches String[] @default([])
}

model Task {
  id        String  @id @default(uuid())
  email     String
  batch     String
  taskId    String
  text      String
  completed Boolean @default(false)

  @@index([email, batch])
}

model Score {
  id      String @id @default(uuid())
  email   String
  batch   String
  scoreId String
  subject String
  score   Int
  date    String

  @@index([email, batch])
}

model Chat {
  id        String   @id @default(uuid())
  email     String
  sender    String
  text      String
  time      String
  createdAt DateTime @default(now())

  @@index([email])
}

model Planner {
  id    String   @id @default(uuid())
  batch String @unique
  tasks String[]
}

model Note {
  id      String  @id @default(uuid())
  batch   String
  email   String?
  name    String
  size    String
  subject String? @default("General")
}

model StudyHour {
  id    String @id @default(uuid())
  email String
  batch String
  mon   Int @default(0)
  tue   Int @default(0)
  wed   Int @default(0)
  thu   Int @default(0)
  fri   Int @default(0)
  sat   Int @default(0)
  sun   Int @default(0)

  @@unique([email, batch])
}

model Notice {
  id        String   @id @default(uuid())
  batch     String
  message   String
  createdAt DateTime @default(now())
}
